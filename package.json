{
  "name": "sist-etiquetas",
  "version": "1.0.0",
  "main": "electron.js",

  "scripts": {
    "start": ".\\node_modules\\.bin\\electron.cmd .",
    "dist": "electron-builder --win nsis --x64",
    "dev": ".\\node_modules\\.bin\\electron.cmd . --enable-logging"
  },

  "build": {
    "appId": "com.cds.sistemaetiquetas",
    "productName": "Sistema Etiquetas",

    "asar": false,

    "directories": {
      "output": "dist"
    },

    "files": [
      "**/*"
    ],

    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },

  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.7"
  },

  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.8.1"
  }
}